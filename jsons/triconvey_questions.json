  "usage_notes": {
    "how_to_use": [
      "1. This file is a TEMPLATE with answer=null for every field",
      "2. A mapping layer reads final_output.json and fills in each answer",
      "3. The filled version is passed to pywinauto for execution",
      "4. Fields with answer=null are SKIPPED (not touched in TriConvey)",
      "5. Fields with answer=false on CheckBox means 'ensure unticked'",
      "6. Fields with answer=true on CheckBox means 'ensure ticked'",
      "7. Fields with inverted=true use OPPOSITE logic (tick when source says NOT connected)"
    ],
    "question_id_format": "tab_shortcode.field_name - stable identifier for mapping layer",
    "selector_strategies": {
      "checkbox_name": "Match by exact CheckBox Name property",
      "label_proximity": "Find Text control with this label, then nearest field control",
      "row": "When multiple controls share a label, use row number to disambiguate",
      "position": "When multiple controls share a label, use position (1-based)"
    }
  }
